# Copy to .env and fill in. Vite inlines every VITE_* value at build time,
# so on Vercel these must be set in Project → Settings → Environment
# Variables and then the project must be redeployed.

# --- Firebase (Web app config from the Firebase console) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Owner dashboard (#/admin) ---
# Passcode for the analytics dashboard. It is a client-side gate only:
# the value is inlined into the shipped JavaScript, so it keeps the
# dashboard out of casual reach, it does not secure the data. The RTDB
# rules are what protect the database.
VITE_ADMIN_PASSCODE=
